# 应用凭据（必填）—— 由企业微信后台「应用管理 → 自建应用」处获取
# 变量名与旧项目保持一致，现有 .env 可直接复用
STOKEN=
S_ENCODING_AES_KEY=
S_CORP_ID=
AGENT_ID=
SECRET=

# 企微 API 入口。能直连官方就用官方；
# 本机/内网到不了官方时，填你自己的反代地址（结尾不要带 /）
WECHAT_PROXY=https://qyapi.weixin.qq.com

# 对外可访问的地址（反代后的域名，结尾不要带 /）。
# 配置后：扫码登录消息里会附带 {此地址}/login/qq 这样的链接，
# 手机不方便看图片消息时可以直接点开扫码页。留空则不显示该行。
MUSICBOT_PUBLIC_BASE_URL=

# 服务监听
MUSICBOT_HOST=0.0.0.0
MUSICBOT_PORT=8000

# 业务
# 默认音乐源：qq 或 wyy
MUSICBOT_DEFAULT_SOURCE=qq
# 每次搜索返回条数（1-50，默认 8）；50 是实测安全上限，再大 QQ 源会返回 0 条
MUSICBOT_SEARCH_LIMIT=8
# 搜索结果（编号）有效期，分钟
MUSICBOT_RESULT_CACHE_MINUTES=5
# Cookie 巡检间隔，分钟。只有状态从可用变不可用才告警，且同一次过期只提醒一次
MUSICBOT_COOKIE_CHECK_INTERVAL_MINUTES=30
# 服务端不给 Cookie 有效期时的兜底阈值，小时
MUSICBOT_COOKIE_TTL_HOURS=48

# 路径（容器里默认 /app/data 与 /app/downloads，一般不用改）
MUSICBOT_DATA_DIR=
MUSICBOT_DOWNLOAD_DIR=

# 运维
MUSICBOT_LOG_LEVEL=INFO
# 是否允许发送图片消息（二维码）。关闭后只发文本 + 链接
MUSICBOT_IMAGE_ENABLED=true
# 装包源（在线更新 musicdl 时用）。客户环境到不了 pypi.org，默认清华镜像
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
